@@ -52,7 +52,15 @@ def motion_blur(x, severity=1):
-    x = cv2.imdecode(np.fromstring(x.make_blob(), np.uint8),
-                    cv2.IMREAD_UNCHANGED)
-
-    if x.shape != (224, 224):
-        return np.clip(x[..., [2, 1, 0]], 0, 255)  # BGR to RGB
-    else:  # greyscale to RGB
-        return np.clip(np.array([x, x, x]).transpose((1, 2, 0)), 0, 255)
+    # Request an encoded format explicitly. ``make_blob()`` without one can
+    # intermittently expose ImageMagick's raw pixel buffer after the in-place
+    # blur. OpenCV may decode that as a malformed Hx3 image or abort in native
+    # code when many LIBERO-plus clients run concurrently.
+    blob = x.make_blob(format="PNG")
+    x = cv2.imdecode(np.frombuffer(blob, dtype=np.uint8), cv2.IMREAD_UNCHANGED)
+    if x is None:
+        raise RuntimeError("ImageMagick motion blur produced an invalid PNG")
+    if x.ndim == 2:  # greyscale to RGB at any configured camera resolution
+        x = np.repeat(x[..., None], 3, axis=-1)
+    elif x.ndim == 3 and x.shape[-1] >= 3:
+        x = x[..., :3][..., [2, 1, 0]]  # BGR to RGB
+    else:
+        raise RuntimeError(f"ImageMagick motion blur produced shape {x.shape}")
+    return np.clip(x, 0, 255)
