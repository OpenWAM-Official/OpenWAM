# Training speedups.
# Layer checkpointing and text encoder offload are configured in configs/train.yaml.
# Usage: bash scripts/train.sh dataloader=libero training.batch_size=32 ...
OPENWAM_TEXT_CACHE=1
OPENWAM_FAST_INPUT=1
OPENWAM_SDPA_CUDNN=1
OPENWAM_FUSED_ROPE=1
OPENWAM_MIXED_ATTN_CKPT=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
OPENWAM_VAE_FULLCLIP=1
OPENWAM_COMPILE_VAE=1
OPENWAM_CONTEXT_TRUNC=1
OPENWAM_COMPILE_BLOCKS=1
OPENWAM_DS_TIMER_NOSYNC=1
OPENWAM_TEXT_MISS_FAST=1
OPENWAM_DS_OVERLAP_COMM=1
OPENWAM_FAST_CAT=1
OPENWAM_GC_FREEZE=1
OPENWAM_VAE_CL=1
OPENWAM_VAE_FIRST=1
OPENWAM_NUMA_BIND=1
