# Training speedups for 80 GB GPUs at 32 per GPU (training.batch_size=32; switches: presets/README.md):
# presets/fast.env + umT5 weights in host memory between text-cache misses + the first 16 MoT layers recomputed in
# the backward. Projected peak per GPU on 8 GPUs: 69.1 GiB (an 80 GB GPU has 79.6 GiB). OPENWAM_CKPT_LAYERS=14 is
# about 1.4 % faster at 73.9 GiB.
# Usage: OPENWAM_PRESET=presets/fast_80gb.env bash scripts/train.sh dataloader=libero training.batch_size=32 ...
OPENWAM_TEXT_CACHE=1
OPENWAM_FAST_INPUT=1
OPENWAM_SDPA_CUDNN=1
OPENWAM_FUSED_ROPE=1
OPENWAM_MIXED_ATTN_CKPT=0
OPENWAM_CKPT_LAYERS=16
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
OPENWAM_VAE_FULLCLIP=1
OPENWAM_COMPILE_VAE=1
OPENWAM_CONTEXT_TRUNC=1
OPENWAM_COMPILE_BLOCKS=1
OPENWAM_DS_TIMER_NOSYNC=1
OPENWAM_TEXT_MISS_FAST=1
OPENWAM_DS_OVERLAP_COMM=1
OPENWAM_FAST_CAT=1
OPENWAM_GC_FREEZE=1
OPENWAM_VAE_CL=1
OPENWAM_VAE_FIRST=1
OPENWAM_NUMA_BIND=1
OPENWAM_TEXT_ENCODER_OFFLOAD=1
