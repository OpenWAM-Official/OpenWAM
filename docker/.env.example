# Copy to .env beside compose.yaml. Set UID/GID to the host directory owner.
# Make and Compose both read this image setting. Use a revision tag for releases.
OPENWAM_IMAGE=openwam:cu128
# Defaults to the Compose directory basename. Choose a distinct name when
# multiple checkouts/bundles share that basename, even if their ports differ.
# COMPOSE_PROJECT_NAME=openwam-my-experiment
OPENWAM_UID=1000
OPENWAM_GID=1000
OPENWAM_GPU_ID=0
OPENWAM_TRAIN_GPUS=0
OPENWAM_BIND_HOST=127.0.0.1
OPENWAM_PORT=8848
OPENWAM_SHM_SIZE=16gb
# Optional on Linux when the host cannot reach the Docker bridge:
# COMPOSE_FILE=compose.yaml:compose.host.yaml
# Source development (requires a checkout):
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
# OPENWAM_SOURCE_DIR=.
# Linked worktrees (from a checkout; both paths must be absolute):
# COMPOSE_FILE=compose.yaml:compose.dev.yaml:compose.worktree.yaml
# OPENWAM_WORKSPACE_DIR=/home/me/openwam-workspace
# OPENWAM_SOURCE_DIR=/home/me/openwam-workspace/feature

# Absolute paths also work, e.g. a directory on a local NVMe disk.
# Create cache/output directories as the selected UID before starting Compose.
OPENWAM_CHECKPOINT_DIR=./assets/openwam_ckpt/openwam_alpha/OpenWAM-Alpha-Sim-RoboTwin-Full
OPENWAM_ASSETS_DIR=./assets
OPENWAM_CACHE_DIR=./.cache/docker
OPENWAM_OUTPUT_DIR=./outputs

# Assets must already include tokenizer/config files when offline.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
WANDB_MODE=offline
# NVIDIA Container Toolkit normally selects compatibility libraries itself.
OPENWAM_CUDA_COMPAT=0
